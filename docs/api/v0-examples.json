{
  "$schema": "https://vibeflow.tools/schemas/v0-examples.json",
  "title": "Vibeflow API v0 per-endpoint examples (Phase 5 docs polish)",
  "description": "Illustrative request/response examples for EVERY registry operation, keyed by operation id. Merged into the OpenAPI document by packages/api-core/scripts/gen-api-artifacts.mjs — never hand-edit the emitted examples. The §6.4 docs coverage guard fails if an operation id here does not match the registry exactly (both directions), or if an emitted operation lacks its example. Ids, tokens and timestamps below are illustrative, not fixtures.",
  "examples": {
    "list-tasks": {
      "request": { "method": "GET", "path": "/api/v0/tasks?status=todo&limit=2" },
      "response": {
        "status": 200,
        "body": {
          "items": [
            {
              "id": "a1b2c3d4e5f60718293a4b5c6d7e8f90",
              "externalId": "a1b2c3d4e5f60718293a4b5c6d7e8f90",
              "title": "Annotate the checkout button",
              "status": "todo",
              "commentCount": 2,
              "fileCount": 1,
              "createdAt": "2026-10-10T09:00:00.000Z"
            }
          ],
          "nextCursor": null
        }
      }
    },
