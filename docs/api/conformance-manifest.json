{
  "$schema": "https://vibeflow.tools/schemas/conformance-manifest.json",
  "title": "Vibeflow API v0 conformance manifest (per-surface runnable)",
  "description": "One entry per contract operation with the cases each must satisfy on both surfaces. `surfaces` names the surfaces whose v0 op exists and whose cases execute there: on `local` the runner executes runnable=local-read cases (writes and handler-less ops are manifest DATA, reported skipped with their target phase); on `cloud` it executes every surfaced entry against the v0 paths and reports the rest skipped by name with `cloudSkipReason`. Phase 0 executes runnable=local-read cases against the local board; writes and handler-less ops are manifest DATA (reported skipped with their target phase) until Phase 3. Open-question resolutions are encoded as cases: D3 external-id presence (get-task/v0-shape), D6 status vocabulary incl. cancelled passthrough (list-tasks/vocabulary + normalizer), comment-author preservation L1 (list-comments/author-preserved), selector-optional delta (create-task case, phase 3).",
  "version": 2,
  "entries": [
    {
      "id": "list-tasks",
      "v0": { "method": "GET", "path": "/api/v0/tasks" },
      "local": { "method": "GET", "path": "/api/tasks" },
      "runnable": "local-read",
      "phase": 0,
      "surfaces": ["local", "cloud"],
      "shape": "task-list",
      "cases": [
        { "name": "green", "request": { "method": "GET", "path": "/api/tasks" }, "expect": { "status": 200, "shape": "task-list", "conformance": "seeded fixture tasks all present; v0 delta: envelope becomes { items, nextCursor } with TaskSummary items" } },
        { "name": "status-filter", "request": { "method": "GET", "path": "/api/tasks", "query": { "status": "todo" } }, "expect": { "status": 200, "shape": "task-list", "conformance": "every returned item has status todo" } },
        { "name": "limit", "request": { "method": "GET", "path": "/api/tasks", "query": { "limit": "1" } }, "expect": { "status": 200, "shape": "task-list", "conformance": "at most 1 item; v0 replaces limit-only with cursor pagination" } },
        { "name": "vocabulary", "request": { "method": "GET", "path": "/api/tasks" }, "expect": { "status": 200, "shape": "task-list", "conformance": "D6: every status is in the canonical vocabulary; 'cancelled' must pass through on read, never map to done (accepted, not emitted locally)" } },
        { "name": "unknown-status-empty", "request": { "method": "GET", "path": "/api/tasks", "query": { "status": "no-such-status" } }, "expect": { "status": 200, "shape": "task-list", "conformance": "unknown filter matches nothing (empty list, still 200)" } }
      ]
    },
    {
      "id": "get-task",
      "v0": { "method": "GET", "path": "/api/v0/tasks/{id}" },
      "local": { "method": "GET", "path": "/api/tasks/{taskId}" },
      "runnable": "local-read",
      "phase": 0,
      "surfaces": ["local", "cloud"],
      "shape": "task",
      "seed": { "taskId": "<fixture todo task>" },
      "cases": [
        { "name": "green", "request": { "method": "GET", "path": "/api/tasks/{taskId}" }, "expect": { "status": 200, "shape": "task", "conformance": "D3: v0 carries id + externalId (equal locally); local Phase 0 carries id (delta recorded, not asserted)" } },
        { "name": "unknown-id-404", "request": { "method": "GET", "path": "/api/tasks/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "expect": { "status": 404, "conformance": "well-formed but unknown id → 404 { error }" } },
        { "name": "malformed-id-400", "request": { "method": "GET", "path": "/api/tasks/not-an-id!!" }, "expect": { "status": 400, "conformance": "router-level id guard rejects before the handler (local app.param guard; v0 documents 404 for get-task, which the cloud answers — see expectCloud)" }, "expectCloud": { "status": 404 } }
      ]
    },
    { "id": "create-task", "v0": { "method": "POST", "path": "/api/v0/tasks" }, "local": { "method": "POST", "path": "/api/tasks" }, "runnable": "write", "phase": 3, "surfaces": ["local", "cloud"], "shape": "task", "cases": [
      { "name": "minimal-no-selector", "request": { "method": "POST", "path": "/api/tasks", "body": { "title": "v0 minimal" } }, "expect": { "status": 200, "shape": "task", "conformance": "v0: selector OPTIONAL (annotation is local-only); local handler requires it today — convergence item" }, "expectCloud": { "status": 201 } },
      { "name": "full", "request": { "method": "POST", "path": "/api/tasks", "body": { "title": "v0 full", "selector": "#app", "priority": "High" } }, "expect": { "status": 200, "shape": "task", "conformance": "created task echoes the write vocabulary" }, "expectCloud": { "status": 201 } }
    ] },
    { "id": "batch-create-tasks", "v0": { "method": "POST", "path": "/api/v0/tasks/batch" }, "local": null, "runnable": "no-local-handler", "phase": 3, "surfaces": ["cloud"], "cases": [
      { "name": "mixed-valid-invalid", "request": { "method": "POST", "path": "/api/v0/tasks/batch", "body": { "items": [{ "title": "v0 batch one" }, { "description": "no title" }, { "title": "v0 batch two", "status": "done" }] } }, "expect": { "status": 200, "conformance": "batch honesty (ticket b4c525fa): envelope 200, per-item [{ id } | { error }] in request order — 2 created + 1 INVALID_TITLE; exact per-item pinning lives in the private v0-batch unit suite (quota-hit, cap boundary)" } },
      { "name": "empty", "request": { "method": "POST", "path": "/api/v0/tasks/batch", "body": { "items": [] } }, "expect": { "status": 200, "conformance": "empty chunk is a no-op success (idempotent-friendly), not a 400" } },
      { "name": "items-not-array", "request": { "method": "POST", "path": "/api/v0/tasks/batch", "body": { "items": { "title": "not an array" } } }, "expect": { "status": 400, "conformance": "non-array items is a caller bug: whole-request 400 INVALID_ITEMS, not per-item errors" } }
    ] },
    { "id": "batch-preflight", "v0": { "method": "GET", "path": "/api/v0/tasks/batch" }, "local": null, "runnable": "no-local-handler", "phase": 3, "surfaces": ["cloud"], "cases": [
      { "name": "green", "request": { "method": "GET", "path": "/api/v0/tasks/batch" }, "expect": { "status": 200, "conformance": "preflight (ticket b4c525fa): { maxItems: 100, plan, open/total limit+used+remaining } before chunk one; exact capacity math pinned in the private v0-batch unit suite" } }
    ] },
    { "id": "patch-task", "v0": { "method": "PATCH", "path": "/api/v0/tasks/{id}" }, "local": { "method": "PATCH", "path": "/api/tasks/{taskId}" }, "runnable": "write", "phase": 3, "surfaces": ["local", "cloud"], "shape": "task", "seed": { "taskId": "<fixture todo task>" }, "cases": [
      { "name": "status-transition", "request": { "method": "PATCH", "path": "/api/tasks/{taskId}", "body": { "status": "in-progress" } }, "expect": { "status": 200, "shape": "task", "conformance": "hyphenated status accepted on write (D6)" } }
    ] },
    { "id": "delete-task", "v0": { "method": "DELETE", "path": "/api/v0/tasks/{id}" }, "local": { "method": "DELETE", "path": "/api/tasks/{taskId}" }, "runnable": "write", "phase": 3, "surfaces": ["local", "cloud"], "shape": "task", "seed": { "taskId": "<fixture leaf task>" }, "cases": [
      { "name": "leaf", "request": { "method": "DELETE", "path": "/api/tasks/{taskId}" }, "expect": { "status": 200, "conformance": "leaf delete; cascade case (D7) runs against a parent fixture in Phase 3" } }
    ] },
    { "id": "mark-opened", "v0": { "method": "POST", "path": "/api/v0/tasks/{id}/opened" }, "local": { "method": "POST", "path": "/api/tasks/{taskId}/opened" }, "runnable": "write", "phase": 3, "surfaces": ["local"], "cloudSkipReason": "no cloud v0 handler: POST /api/v0/tasks/{id}/opened does not exist cloud-side (opened presence is a local concept); skipped on the cloud surface", "seed": { "taskId": "<fixture todo task>" }, "cases": [
      { "name": "green", "request": { "method": "POST", "path": "/api/tasks/{taskId}/opened" }, "expect": { "status": 200, "conformance": "presence recorded" } }
    ] },
    { "id": "mark-expanded", "v0": { "method": "POST", "path": "/api/v0/tasks/{id}/expanded" }, "local": { "method": "POST", "path": "/api/tasks/{taskId}/expanded" }, "runnable": "write", "phase": 3, "surfaces": ["local"], "cloudSkipReason": "no cloud v0 handler: POST /api/v0/tasks/{id}/expanded does not exist cloud-side (expanded presence is a local concept); skipped on the cloud surface", "seed": { "taskId": "<fixture todo task>" }, "cases": [
      { "name": "green", "request": { "method": "POST", "path": "/api/tasks/{taskId}/expanded" }, "expect": { "status": 200, "conformance": "expanded state recorded" } }
    ] },
    { "id": "add-link", "v0": { "method": "POST", "path": "/api/v0/tasks/{id}/links" }, "local": { "method": "PATCH", "path": "/api/tasks/{taskId}" }, "runnable": "write", "phase": 3, "surfaces": ["local", "cloud"], "shape": "task", "seed": { "taskId": "<fixture todo task>" }, "cases": [
      { "name": "green", "request": { "method": "POST", "path": "/api/v0/tasks/{taskId}/links", "body": { "type": "relates", "taskId": "<other>" } }, "expect": { "status": 200, "shape": "task", "conformance": "genuine gap: no dedicated local route today (links ride on update; local PATCH answers 200)" }, "expectCloud": { "status": 201 } }
    ] },
    { "id": "remove-link", "v0": { "method": "DELETE", "path": "/api/v0/tasks/{id}/links/{type}/{target}" }, "local": { "method": "POST", "path": "/api/tasks/{taskId}/detach" }, "runnable": "write", "phase": 3, "surfaces": ["local", "cloud"], "seed": { "taskId": "<fixture child task>" }, "cases": [
      { "name": "green", "request": { "method": "DELETE", "path": "/api/v0/tasks/{taskId}/links/parent/{target}" }, "expect": { "status": 200, "conformance": "typed removal; local detach is the pre-image" } }
    ] },
    { "id": "claim-next", "v0": { "method": "POST", "path": "/api/v0/tasks/claim-next" }, "local": null, "runnable": "no-local-handler", "phase": 3, "surfaces": ["local", "cloud"], "cases": [
      { "name": "green", "request": { "method": "POST", "path": "/api/v0/tasks/claim-next", "body": {} }, "expect": { "status": 200, "conformance": "atomic claim; cloud needs SELECT FOR UPDATE SKIP LOCKED — real design work, listed so it is not dropped" } }
    ] },
    { "id": "verify-task", "v0": { "method": "POST", "path": "/api/v0/tasks/{id}/verify" }, "local": null, "runnable": "no-local-handler", "phase": 3, "surfaces": ["local", "cloud"], "seed": { "taskId": "<fixture todo task>" }, "cases": [
      { "name": "pass", "request": { "method": "POST", "path": "/api/v0/tasks/{taskId}/verify", "body": { "verdict": "pass" } }, "expect": { "status": 200, "conformance": "verdict tri-state; verified=true" } },
      { "name": "cannot-writes-comment", "request": { "method": "POST", "path": "/api/v0/tasks/{taskId}/verify", "body": { "verdict": "cannot", "reason": "needs staging" } }, "expect": { "status": 200, "conformance": "'cannot' also writes the **Cannot verify:** comment" } }
    ] },
    {
      "id": "list-comments",
      "v0": { "method": "GET", "path": "/api/v0/tasks/{id}/comments" },
      "local": { "method": "GET", "path": "/api/tasks/{taskId}/comments" },
      "runnable": "local-read",
      "phase": 0,
      "surfaces": ["local", "cloud"],
      "shape": "comment-list",
      "seed": { "taskId": "<fixture commented task>" },
      "cases": [
        { "name": "green", "request": { "method": "GET", "path": "/api/tasks/{taskId}/comments" }, "expect": { "status": 200, "shape": "comment-list", "conformance": "seeded user + agent comments present" } },
        { "name": "author-preserved", "request": { "method": "GET", "path": "/api/tasks/{taskId}/comments" }, "expect": { "status": 200, "shape": "comment-list", "conformance": "L1: author reads back verbatim (user|agent); the normalizer throws if author is absent" } },
        { "name": "unknown-task-empty-200", "request": { "method": "GET", "path": "/api/tasks/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/comments" }, "expect": { "status": 200, "shape": "comment-list", "conformance": "DIVERGENCE NOTED: local returns 200 empty for an unknown task; v0 error convention says 404 unknown id (the cloud answers 404 — see expectCloud) — convergence item for Phase 1/3, asserted here so the difference cannot slip through silently" }, "expectCloud": { "status": 404 } }
      ]
    },
    { "id": "add-comment", "v0": { "method": "POST", "path": "/api/v0/tasks/{id}/comments" }, "local": { "method": "POST", "path": "/api/tasks/{taskId}/comments" }, "runnable": "write", "phase": 3, "surfaces": ["local", "cloud"], "seed": { "taskId": "<fixture todo task>" }, "cases": [
      { "name": "green", "request": { "method": "POST", "path": "/api/tasks/{taskId}/comments", "body": { "author": "agent", "text": "L1 probe" } }, "expect": { "status": 200, "conformance": "written author reads back verbatim (L1)" } }
    ] },
    { "id": "patch-comment", "v0": { "method": "PATCH", "path": "/api/v0/tasks/{id}/comments/{commentId}" }, "local": { "method": "PATCH", "path": "/api/tasks/{taskId}/comments/{commentId}" }, "runnable": "write", "phase": 3, "surfaces": ["local", "cloud"], "seed": { "taskId": "<fixture commented task>", "commentId": "<seeded>" }, "cases": [
      { "name": "green", "request": { "method": "PATCH", "path": "/api/tasks/{taskId}/comments/{commentId}", "body": { "text": "edited" } }, "expect": { "status": 200, "conformance": "text updated, author untouched" } }
    ] },
    { "id": "delete-comment", "v0": { "method": "DELETE", "path": "/api/v0/tasks/{id}/comments/{commentId}" }, "local": { "method": "DELETE", "path": "/api/tasks/{taskId}/comments/{commentId}" }, "runnable": "write", "phase": 3, "surfaces": ["local", "cloud"], "seed": { "taskId": "<fixture commented task>", "commentId": "<seeded>" }, "cases": [
      { "name": "green", "request": { "method": "DELETE", "path": "/api/tasks/{taskId}/comments/{commentId}" }, "expect": { "status": 200, "conformance": "soft-delete trace kept" } }
    ] },
    {
      "id": "list-files",
      "v0": { "method": "GET", "path": "/api/v0/tasks/{id}/files" },
      "local": { "method": "GET", "path": "/api/tasks/{taskId}/files" },
      "runnable": "local-read",
      "phase": 0,
      "surfaces": ["local", "cloud"],
      "shape": "file-list",
      "seed": { "taskId": "<fixture file task>" },
      "cases": [
        { "name": "green", "request": { "method": "GET", "path": "/api/tasks/{taskId}/files" }, "expect": { "status": 200, "shape": "file-list", "conformance": "seeded text + binary files listed" } },
        { "name": "unknown-task-empty-200", "request": { "method": "GET", "path": "/api/tasks/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/files" }, "expect": { "status": 200, "shape": "file-list", "conformance": "DIVERGENCE NOTED: local returns 200 empty for an unknown task; v0 error convention says 404 unknown id (the cloud answers 404 — see expectCloud) — convergence item, see list-comments" }, "expectCloud": { "status": 404 } }
      ]
    },
    { "id": "upload-file", "v0": { "method": "POST", "path": "/api/v0/tasks/{id}/files" }, "local": { "method": "POST", "path": "/api/tasks/{taskId}/files/{filename}" }, "runnable": "write", "phase": 3, "surfaces": ["local", "cloud"], "seed": { "taskId": "<fixture todo task>" }, "cases": [
      { "name": "raw-body", "request": { "method": "POST", "path": "/api/tasks/{taskId}/files/note.txt" }, "cloudRequest": { "method": "POST", "path": "/api/v0/tasks/{taskId}/files", "rawBody": "hello conformance\n", "headers": { "content-type": "text/plain", "x-filename": "note.txt" } }, "expect": { "status": 200, "conformance": "raw body accepted; multipart also accepted (both, not either). Cloud takes the v0 shape (POST .../files + x-filename header) — the filename-in-path case path is the local shape" } },
      { "name": "disallowed-type-415", "request": { "method": "POST", "path": "/api/tasks/{taskId}/files/run.exe" }, "cloudRequest": { "method": "POST", "path": "/api/v0/tasks/{taskId}/files", "rawBody": "MZ fake executable", "headers": { "content-type": "application/octet-stream", "x-filename": "run.exe" } }, "expect": { "status": 415, "conformance": "allowlist enforced (extension vs MIME is the residual divergence)" } }
    ] },
    {
      "id": "get-file",
      "v0": { "method": "GET", "path": "/api/v0/tasks/{id}/files/{fileId}" },
      "local": { "method": "GET", "path": "/api/tasks/{taskId}/files/{filename}" },
      "runnable": "local-read",
      "phase": 0,
      "surfaces": ["local", "cloud"],
      "shape": "raw-bytes",
      "seed": { "taskId": "<fixture file task>", "filename": "note.txt", "fileId": "<seeded>" },
      "cases": [
        { "name": "green-bytes", "request": { "method": "GET", "path": "/api/tasks/{taskId}/files/{filename}" }, "cloudRequest": { "method": "GET", "path": "/api/v0/tasks/{taskId}/files/{fileId}" }, "expect": { "status": 200, "shape": "raw-bytes", "conformance": "bytes round-trip against the seeded content. Cloud addresses files by id (v0 path) — the filename case path is the local shape" } },
        { "name": "unknown-file-404", "request": { "method": "GET", "path": "/api/tasks/{taskId}/files/missing.txt" }, "expect": { "status": 404, "conformance": "unknown filename → 404" } }
      ]
    },
    { "id": "delete-file", "v0": { "method": "DELETE", "path": "/api/v0/tasks/{id}/files/{fileId}" }, "local": { "method": "DELETE", "path": "/api/tasks/{taskId}/files/{filename}" }, "runnable": "write", "phase": 3, "surfaces": ["local", "cloud"], "seed": { "taskId": "<fixture file task>", "filename": "note.txt", "fileId": "<seeded>" }, "cases": [
      { "name": "green", "request": { "method": "DELETE", "path": "/api/tasks/{taskId}/files/{filename}" }, "cloudRequest": { "method": "DELETE", "path": "/api/v0/tasks/{taskId}/files/{fileId}" }, "expect": { "status": 200, "conformance": "system trace comment records the removal. Cloud addresses files by id (v0 path) — the filename case path is the local shape" } }
    ] },
    { "id": "put-screenshot", "v0": { "method": "POST", "path": "/api/v0/tasks/{id}/screenshot" }, "local": { "method": "POST", "path": "/api/tasks/{taskId}/screenshot" }, "runnable": "write", "phase": 3, "surfaces": ["local", "cloud"], "seed": { "taskId": "<fixture todo task>" }, "cases": [
      { "name": "green", "request": { "method": "POST", "path": "/api/tasks/{taskId}/screenshot", "body": { "screenshot": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==" } }, "expect": { "status": 200, "shape": "screenshot-result", "conformance": "v0 success shape { success, screenshot }; cloud stores as a system file via the files port" } }
    ] },
    { "id": "delete-screenshot", "v0": { "method": "DELETE", "path": "/api/v0/tasks/{id}/screenshot" }, "local": { "method": "DELETE", "path": "/api/tasks/{taskId}/screenshot" }, "runnable": "write", "phase": 3, "surfaces": ["local", "cloud"], "seed": { "taskId": "<fixture todo task>" }, "cases": [
      { "name": "green", "request": { "method": "DELETE", "path": "/api/tasks/{taskId}/screenshot" }, "expect": { "status": 200, "conformance": "screenshot slot cleared" } }
    ] },
    { "id": "put-baseline", "v0": { "method": "POST", "path": "/api/v0/tasks/{id}/baseline" }, "local": { "method": "POST", "path": "/api/tasks/{taskId}/baseline" }, "runnable": "write", "phase": 3, "surfaces": ["local", "cloud"], "seed": { "taskId": "<fixture todo task>" }, "cases": [
      { "name": "element-envelope", "request": { "method": "POST", "path": "/api/tasks/{taskId}/baseline", "body": { "baseline": { "selector": "#a", "outerHTML": "<a/>" } } }, "expect": { "status": 200, "conformance": "merged envelope: element and page snapshots in one call" } }
    ] },
    { "id": "put-baseline-page", "v0": { "method": "POST", "path": "/api/v0/tasks/{id}/baseline-page" }, "local": { "method": "POST", "path": "/api/tasks/{taskId}/baseline-page" }, "runnable": "write", "phase": 3, "surfaces": ["local", "cloud"], "seed": { "taskId": "<fixture todo task>" }, "cases": [
      { "name": "page-envelope", "request": { "method": "POST", "path": "/api/tasks/{taskId}/baseline-page", "body": { "page": { "version": 1, "elements": {}, "capturedAt": "<iso>", "truncated": false } } }, "expect": { "status": 200, "conformance": "page snapshot stored as the baseline-page.json system file; requires page.version 1 + page.elements" } }
    ] },
    { "id": "put-auth-state", "v0": { "method": "POST", "path": "/api/v0/tasks/{id}/auth-state" }, "local": { "method": "POST", "path": "/api/tasks/{taskId}/auth-state" }, "runnable": "write", "phase": 3, "surfaces": ["local", "cloud"], "seed": { "taskId": "<fixture todo task>" }, "cases": [
      { "name": "cloud-501", "request": { "method": "POST", "path": "/api/v0/tasks/{taskId}/auth-state" }, "expect": { "status": 501, "conformance": "LOCAL_ONLY on cloud — truthful 501 with machine code, never silent divergence" } }
    ] },
    {
      "id": "get-project",
      "v0": { "method": "GET", "path": "/api/v0/project" },
      "local": { "method": "GET", "path": "/api/project" },
      "runnable": "local-read",
      "phase": 0,
      "surfaces": ["local"],
      "cloudSkipReason": "local-only: no cloud GET /api/v0/project (the project dir / scope description is a local concept); skipped on the cloud surface",
      "shape": "project",
      "cases": [
        { "name": "green", "request": { "method": "GET", "path": "/api/project" }, "expect": { "status": 200, "shape": "project", "conformance": "scope description shape" } }
      ]
    },
    {
      "id": "get-me",
      "v0": { "method": "GET", "path": "/api/v0/me" },
      "local": { "method": "GET", "path": "/api/user" },
      "runnable": "local-read",
      "phase": 0,
      "surfaces": ["local", "cloud"],
      "shape": "me",
      "cases": [
        { "name": "green", "request": { "method": "GET", "path": "/api/user" }, "expect": { "status": 200, "shape": "me", "conformance": "git user shape" } }
      ]
    },
    {
      "id": "get-settings",
      "v0": { "method": "GET", "path": "/api/v0/settings" },
      "local": { "method": "GET", "path": "/api/settings" },
      "runnable": "local-read",
      "phase": 0,
      "surfaces": ["local", "cloud"],
      "shape": "settings",
      "cases": [
        { "name": "green", "request": { "method": "GET", "path": "/api/settings" }, "expect": { "status": 200, "shape": "settings", "conformance": "settings object" } }
      ]
    },
    { "id": "patch-settings", "v0": { "method": "PATCH", "path": "/api/v0/settings" }, "local": { "method": "POST", "path": "/api/settings" }, "runnable": "write", "phase": 3, "surfaces": ["local", "cloud"], "cases": [
      { "name": "green", "request": { "method": "PATCH", "path": "/api/v0/settings", "body": { "viewMode": "compact" } }, "expect": { "status": 200, "conformance": "v0 PATCH vs local POST — method convergence item" } }
    ] },
    {
      "id": "get-changelog",
      "v0": { "method": "GET", "path": "/api/v0/changelog" },
      "local": { "method": "GET", "path": "/api/changelog" },
      "runnable": "local-read",
      "phase": 0,
      "surfaces": ["local"],
      "cloudSkipReason": "local-only: no cloud GET /api/v0/changelog; skipped on the cloud surface",
      "shape": "changelog",
      "cases": [
        { "name": "green", "request": { "method": "GET", "path": "/api/changelog" }, "expect": { "status": 200, "shape": "changelog", "conformance": "public read, no auth" } }
      ]
    },
