{
  "name": "vibeflow",
  "version": "1.0.0",
  "description": "Vibeflow — annotate, iterate, and ship faster with your AI agent",
  "private": true,
  "license": "Apache-2.0",
  "author": "Tomislav Zorcec <vibeflow.tools@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @vibeflow-tools/cli run build",
    "build:prototyping": "pnpm --filter @vibeflow-tools/prototyping run build",
    "build:all": "pnpm -r run build",
    "dev": "pnpm --filter @vibeflow-tools/cli run dev",
    "test": "pnpm --filter @vibeflow-tools/cli run test",
    "test:prototyping": "pnpm --filter @vibeflow-tools/prototyping run test",
    "test:all": "pnpm -r run test",
    "test:integration": "pnpm --filter @vibeflow-tools/cli run test:integration",
    "test:e2e": "pnpm --filter @vibeflow-tools/cli run test:e2e",
    "test:browser": "pnpm --filter @vibeflow-tools/cli run test:browser",
    "test:coverage": "pnpm --filter @vibeflow-tools/cli run test:coverage",
    "lint:symbols": "eslint \"packages/*/src/**/*.{ts,tsx}\"",
    "lint": "pnpm run lint:symbols && pnpm -r run lint",
    "scan:secrets": "gitleaks detect --source . --staged --verbose",
    "scan:secrets:full": "gitleaks detect --source . --verbose",
    "check": "pnpm run lint:symbols && pnpm --filter @vibeflow-tools/cli run lint && pnpm run check:parity",
    "check:parity": "pnpm --filter @vibeflow-tools/cli run test tests/unit/mcp/drift.test.ts",
    "mutation": "pnpm --filter @vibeflow-tools/cli run mutation",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "typescript-eslint": "^8.70.0"
  }
}
