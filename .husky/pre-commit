#!/usr/bin/env sh
set -e

# Hooks can be bypassed via --no-verify/core.hooksPath (or HUSKY=0); the unit history test is the backstop.
node scripts/check-git-identity.mjs

# ── ADR reference guard (docs/decisions) ──────────────────────────────────────
# Fast (~1s), dependency-free: every ADR-NNNN pointer resolves, every accepted
# ADR declares Pins: that exist, index.md lists every ADR with no phantom rows,
# and governed code has not drifted past its Reviewed: date (ADR-0004).
node scripts/check-adrs.mjs

# ── Credential guard (ADR-0005) ────────────────────────────────────────────
# Project-scoped auth keeps secrets in ~/.vibeflow/credentials.json (never
# the repo). Block credential store paths from being staged.
node scripts/check-no-credentials.mjs

# Ensure system-installed tools like gitleaks are on PATH
export PATH="/usr/local/bin:$PATH"

# ── Secret scan ────────────────────────────────────────────────────────────────
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "✗ gitleaks not installed — cannot commit without secret scan."
  echo "  Install: https://github.com/gitleaks/gitleaks#installing"
  exit 1
fi
gitleaks protect --staged --source .
echo "✓ Secret scan passed."

# ── Task store integrity (ticket 8538344b) ───────────────────────────────────
# A synced .vibeflow must never be committed with unparseable JSON: conflict
# markers or truncated files quarantine silently and tasks vanish from every
# listing. Fast (~200ms for ~2000 files), dependency-free, exits 0 when no
# store exists — so checkouts without a synced store are unaffected.
echo "Checking task store integrity..."
pnpm check:store
echo "✓ Store check passed."

# ── Type check ─────────────────────────────────────────────────────────────────
echo "Running type check..."
pnpm run check

# ── Build ──────────────────────────────────────────────────────────────────────
echo "Running build..."
pnpm run build

# ── Unit tests ─────────────────────────────────────────────────────────────────
echo "Running unit tests..."
pnpm run test

echo "✓ All checks passed."
