#!/usr/bin/env sh
set -e

# Worktree safety (ticket e138e51d): git exports an absolute GIT_DIR when
# invoking hooks in a linked worktree; child test processes inherit it, so
# every `git -C <tmpdir>` resolves to this repo instead of failing. Unset so
# suites see a normal repo context resolved from cwd.
unset GIT_DIR GIT_WORK_TREE

# ── Vibeflow pre-push gate ─────────────────────────────────────────────────────
# Runs only the suites the pushed paths can break (affected-only, child
# 6fc455a3; ADR-0004 — this hook is the gate, there is no remote CI).
# The path→suite map lives in scripts/affected-suites.mjs —
# an unmapped path, a shallow/unavailable base, or a force push runs
# EVERYTHING (fail closed), and a docs-only push runs nothing.
#
# Expected cost when everything is selected: unit ~13s, e2e ~43s,
# integration ~1s, playwright ~26s, ui ~20s (unit ~16s + stories ~4s)
# (~103s).
#
# Unit and integration are treated as deterministic: first failure halts the
# hook and blocks the push. They are never retried.
#
# e2e and Playwright are retried ONCE. Both bind ephemeral ports, and port
# binding is inherently racy: an observed e2e failure was
#   tests/e2e/mcp-stdio.test.ts > start_kanban over stdio
#   "start_kanban did not bind a reachable kanban URL"
# and Playwright had a known EADDRINUSE collision (its hardcoded ports are now
# gone — it uses getFreePort() with a bounded retry). A gate that blocks on a
# transient port race trains you to reach for --no-verify, which is worse than
# no gate at all; a single retry removes that pressure while a SECOND failure
# still blocks the push and is reported as a real failure.
#
# Escape hatches (each prints a visible notice when used):
#   VIBEFLOW_SKIP_PREPUSH=1  skip every suite
#   VIBEFLOW_SKIP_BROWSER=1  skip Playwright only
# No other env skip exists: the selector is never bypassed by environment.
#
# Debug (prints the chosen suites for the push range without running them):
#   VIBEFLOW_PREPUSH_DRY_RUN=1 git push --dry-run
#   node scripts/affected-suites.mjs --dry-run --range <base>..<head>

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
CLI_DIR="$ROOT/packages/cli"

# Read the push range from stdin FIRST and only once: stdin is a single pipe,
# so the identity check and the selector below share this capture — whoever
# read it first would otherwise drain it for the other (an empty selection
# input fail-closes to ALL, so a drained stdin silently ran every suite).
# A later `pnpm` must also never inherit a half-consumed stdin.
PUSH_INFO="$(cat)"

# Check every ref's outgoing commits before any optional suite skips. The hook
# sets `set -e` but not `pipefail`, so the piped identity gate is guarded
# with `if !` — a bare pipe would swallow its failure and weaken the gate.
if ! printf '%s' "$PUSH_INFO" | node "$ROOT/scripts/check-git-identity.mjs" --pre-push "${1:-origin}"; then
  exit 1
fi

# ── Affected-only selection ────────────────────────────────────────────────────
# Ask the selector which suites the captured paths break. Empty/unreadable
# input, an unavailable base, or a force push selects ALL (fail closed — the
# selector decides, never this shell).
SELECTED_SUITES="$(printf '%s' "$PUSH_INFO" | node "$ROOT/scripts/affected-suites.mjs" --print --remote "${1:-origin}")"

if [ "${VIBEFLOW_PREPUSH_DRY_RUN:-}" = "1" ]; then
  echo "pre-push dry-run — selected suites for this push range: $SELECTED_SUITES"
  echo "(nothing ran; remove VIBEFLOW_PREPUSH_DRY_RUN=1 to run the gate for real.)"
  exit 0
fi

wants_suite() {
  case " $SELECTED_SUITES " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

echo "pre-push — selected suites for this push range: $SELECTED_SUITES"

if [ ! -d "$CLI_DIR" ]; then
  echo "✗ pre-push: cannot find $CLI_DIR (expected repo root: $ROOT)"
  exit 1
fi

cd "$CLI_DIR"

UNIT="not run"
E2E="not run"
INTEGRATION="not run"
BROWSER="not run"
UI="not run"

print_summary() {
  echo ""
  echo "───────────────── Pre-push summary ─────────────────"
  printf '  %-12s %s\n' "unit" "$UNIT"
  printf '  %-12s %s\n' "e2e" "$E2E"
  printf '  %-12s %s\n' "integration" "$INTEGRATION"
  printf '  %-12s %s\n' "playwright" "$BROWSER"
  printf '  %-12s %s\n' "ui" "$UI"
  echo "─────────────────────────────────────────────────────"
}

# ── Skip everything ────────────────────────────────────────────────────────────
if [ "${VIBEFLOW_SKIP_PREPUSH:-}" = "1" ]; then
  echo "⚠ VIBEFLOW_SKIP_PREPUSH=1 — skipping ALL pre-push checks (unit, e2e, integration, playwright, ui)."
  UNIT="SKIPPED"
  E2E="SKIPPED"
  INTEGRATION="SKIPPED"
  BROWSER="SKIPPED"
  UI="SKIPPED"
  print_summary
  echo "⚠ Push allowed WITHOUT any test verification."
  exit 0
fi

# ── Unit tests (hard) ──────────────────────────────────────────────────────────
if wants_suite "unit"; then
echo ""
echo "▶ unit — pnpm run test"
if pnpm run test; then
  UNIT="PASS"
else
  UNIT="FAIL"
  print_summary
  echo "✗ Unit tests failed — blocking push."
  exit 1
fi
else
  echo ""
  echo "– unit — not selected for this push range (unaffected)."
  UNIT="SKIPPED (unaffected)"
fi

# ── E2E tests (retry once) ───────────────────────────────────────────────────
if wants_suite "e2e"; then
echo ""
echo "▶ e2e — pnpm run test:e2e (attempt 1/2)"
if pnpm run test:e2e; then
  E2E="PASS"
else
  echo "⚠ WARNING: e2e FAILED on attempt 1/2"
  echo "  These tests bind ephemeral ports; a single collision is a known race."
  echo "  Retrying ONCE. If attempt 2 also fails, the push is BLOCKED."
  echo ""
  echo "▶ e2e — pnpm run test:e2e (attempt 2/2)"
  if pnpm run test:e2e; then
    E2E="PASS (attempt 2 — attempt 1 hit the known port-binding race)"
  else
    E2E="FAIL (both attempts)"
    print_summary
    echo "✗ e2e failed on BOTH attempts — treated as a real failure. Push blocked."
    exit 1
  fi
fi
else
  echo ""
  echo "– e2e — not selected for this push range (unaffected)."
  E2E="SKIPPED (unaffected)"
fi

# ── Integration tests (hard) ───────────────────────────────────────────────────
if wants_suite "integration"; then
echo ""
echo "▶ integration — pnpm run test:integration"
if pnpm run test:integration; then
  INTEGRATION="PASS"
else
  INTEGRATION="FAIL"
  print_summary
  echo "✗ Integration tests failed — blocking push."
  exit 1
fi
else
  echo ""
  echo "– integration — not selected for this push range (unaffected)."
  INTEGRATION="SKIPPED (unaffected)"
fi

# ── Playwright (retry once) ────────────────────────────────────────────────────
if ! wants_suite "playwright"; then
  echo ""
  echo "– playwright — not selected for this push range (unaffected)."
  BROWSER="SKIPPED (unaffected)"
elif [ "${VIBEFLOW_SKIP_BROWSER:-}" = "1" ]; then
  echo ""
  echo "⚠ VIBEFLOW_SKIP_BROWSER=1 — skipping the Playwright suite (unit, e2e and integration still ran)."
  BROWSER="SKIPPED"
else
  echo ""
  echo "▶ playwright — pnpm run test:browser (attempt 1/2)"
  if pnpm run test:browser; then
    BROWSER="PASS (attempt 1)"
  else
    echo ""
    echo "══════════════════════════════════════════════════════════════════"
    echo "⚠ WARNING: Playwright FAILED on attempt 1/2"
    echo ""
    echo "  This suite has a KNOWN intermittent EADDRINUSE flake — the"
    echo "  Playwright web server occasionally collides on a port with a"
    echo "  process still holding it from the previous run."
    echo ""
    echo "  Retrying ONCE. If attempt 2 also fails, the push is BLOCKED."
    echo "══════════════════════════════════════════════════════════════════"
    echo ""
    echo "▶ playwright — pnpm run test:browser (attempt 2/2)"
    if pnpm run test:browser; then
      BROWSER="PASS (attempt 2 — attempt 1 hit the known port-collision flake)"
    else
      BROWSER="FAIL (both attempts)"
      print_summary
      echo "✗ Playwright failed on BOTH attempts — treated as a real failure. Push blocked."
      exit 1
    fi
  fi
fi

# ── UI design-system tests (hard) ────────────────────────────────────────────
# Deterministic like unit (jsdom unit suite + headless-chromium story tests
# via the Storybook vitest addon): first failure halts the hook and blocks
# the push. Never retried — no known port race in this lane. The six-theme
# axe sweep lives INSIDE the unit suite (a11y-themes.test.tsx, ~2.5s), so it
# already runs here; the v8 coverage gate stays out (see `coverage` script).
if wants_suite "ui"; then
echo ""
echo "▶ ui — bundle budget + pnpm --filter @vibeflow-tools/ui run test + test:stories"
# The budget check is cheap (stat + one regex) and lives here on purpose: the
# expensive design-system gates (storybook build, overlay pixel guard,
# coverage) are in `pnpm gate:ui` — see docs/ui/design-system-gates.md.
# Called by path: the hook has cd'd into packages/cli, where the root script
# name does not resolve ("Missing script: check:bundle-budget" — measured).
if node "$ROOT/packages/cli/scripts/check-bundle-budget.mjs" && pnpm --filter @vibeflow-tools/ui run test && pnpm --filter @vibeflow-tools/ui run test:stories; then
  UI="PASS"
else
  UI="FAIL"
  print_summary
  echo "✗ UI tests failed — blocking push."
  exit 1
fi
else
  echo ""
  echo "– ui — not selected for this push range (unaffected)."
  UI="SKIPPED (unaffected)"
fi

print_summary
echo "✓ All pre-push checks passed — push allowed."
exit 0
